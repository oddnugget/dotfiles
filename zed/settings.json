// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "vim": {
    "use_smartcase_find": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "diff_view_style": "unified",
  "languages": {
    "HTML": {
      "preferred_line_length": 81,
    },
    "HEEx": {
      "language_servers": ["!tailwindcss-language-server"],
    },
    "Elixir": {
      "language_servers": ["expert", "!elixir-ls", "!next-ls", "!lexical"],
      "format_on_save": "on",
    },
    "Ruby": {
      "language_servers": ["ruby-lsp", "!solargraph"],
    },
  },
  "use_on_type_format": false,
  "format_on_save": "on",
  "ssh_connections": [
    {
      "host": "devbox",
      "args": [],
      "projects": [
        {
          "paths": ["/home/odyrag/projects/barsoom/auctionet"],
        },
        {
          "paths": ["/home/odyrag/projects/barsoom/devbox/./"],
        },
        {
          "paths": ["/home/odyrag/projects/barsoom/ex-remit"],
        },
        {
          "paths": ["/home/odyrag/projects/barsoom/logan"],
        },
        {
          "paths": ["/home/odyrag/projects/barsoom/neopris/./"],
        },
        {
          "paths": ["/home/odyrag/projects/barsoom/skipper"],
        },
      ],
    },
  ],
  "edit_predictions": { "mode": "subtle" },
  "terminal": {
    "copy_on_select": true,
  },
  "vim_mode": true,
  "ui_font_size": 13.0,
  "buffer_font_size": 11.0,
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Catppuccin Macchiato",
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 0.85,
  },
  "search": {
    "whole_word": false,
    "case_sensitive": false,
    "include_ignored": false,
    "regex": true,
  },
}
