# vim: set ft=gitconfig
# REF: https://jvns.ca/blog/2024/02/16/popular-git-config-options/#push-default-simple-push-default-current

[core]
	pager = delta

[user]
	name = oddnugget
	email = odysseas.ragnarson@outlook.com

[includeIf "gitdir:~/projects/barsoom/"]
	path = ~/.work.gitconfig

[init]
	defaultBranch = main

[commit]
	verbose = true

[tag]
	sort = version:refname

[help]
	autocorrect = prompt

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[fetch]
	prune = true

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[branch]
	sort = -committerdate

[rerere]
	enabled = true
	autoupdate = true

# Fetch over https (works without keys, e.g. on a fresh machine), push over ssh
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

